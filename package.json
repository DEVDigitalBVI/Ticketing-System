{
  "name": "peter-island-resort-it-service-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Peter Island Resort and Spa IT Service Desk",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
