# Browser-safe value. Variables prefixed with NEXT_PUBLIC_ are included in client bundles.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Server-only values. Never prefix database credentials with NEXT_PUBLIC_.
DATABASE_URL=postgresql://resort_app:local_development_only@127.0.0.1:54329/resort_service_desk?schema=service_desk
DATABASE_DIRECT_URL=postgresql://resort_app:local_development_only@127.0.0.1:54329/resort_service_desk?schema=service_desk
TEST_DATABASE_URL=postgresql://resort_app:local_development_only@127.0.0.1:54329/resort_service_desk_test?schema=service_desk
