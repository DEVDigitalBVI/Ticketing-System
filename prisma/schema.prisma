  errorCode      String?       @map("error_code")
  errorMessage   String?       @map("error_message")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  job            BackgroundJob @relation(fields: [jobId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([jobId, attemptNumber])
  @@index([organizationId, startedAt])
