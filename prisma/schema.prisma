generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["service_desk"]
}

model Organization {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String       @unique
  name        String
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  properties  Property[]
  users       User[]
  roles       Role[]
  userRoles   UserRole[]
  auditEvents AuditEvent[]

  @@map("organizations")
  @@schema("service_desk")
}

model Property {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String
  name           String
  timezone       String
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  departments    Department[]
  userRoles      UserRole[]
  auditEvents    AuditEvent[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("properties")
  @@schema("service_desk")
}

model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  code           String
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  property       Property @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@unique([propertyId, code])
  @@unique([propertyId, name])
  @@index([organizationId])
  @@index([propertyId, organizationId])
  @@map("departments")
  @@schema("service_desk")
}

model User {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String
  displayName    String       @map("display_name")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roles          UserRole[]
  auditEvents    AuditEvent[]

  @@unique([id, organizationId])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
  @@schema("service_desk")
}

model Role {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  users          UserRole[]

  @@unique([id, organizationId])
  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
  @@schema("service_desk")
}

model UserRole {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  propertyId     String       @map("property_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user           User         @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  role           Role         @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  property       Property     @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, roleId, propertyId])
  @@index([organizationId])
  @@index([userId, organizationId])
  @@index([roleId, organizationId])
  @@index([propertyId, organizationId])
  @@map("user_roles")
  @@schema("service_desk")
}

model AuditEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  propertyId     String?      @map("property_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id")
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  property       Property?    @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  actor          User?        @relation(fields: [actorUserId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, createdAt])
  @@index([propertyId, organizationId])
  @@index([actorUserId, organizationId])
  @@map("audit_events")
  @@schema("service_desk")
}
