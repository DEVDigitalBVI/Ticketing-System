model Asset {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                 @map("organization_id") @db.Uuid
  assetTag          String                 @map("asset_tag")
  serialNumber      String?                @map("serial_number")
  name              String
  description       String?
  assetTypeId       String                 @map("asset_type_id") @db.Uuid
  assetStatusId     String                 @map("asset_status_id") @db.Uuid
  propertyId        String                 @map("property_id") @db.Uuid
  buildingAreaId    String?                @map("building_area_id") @db.Uuid
  serviceLocationId String?                @map("service_location_id") @db.Uuid
  departmentId      String?                @map("department_id") @db.Uuid
  custodianUserId   String?                @map("custodian_user_id") @db.Uuid
  criticality       String                 @default("standard")
  manufacturer      String?
  model             String?
  acquiredAt        DateTime?              @map("acquired_at") @db.Date
  retiredAt         DateTime?              @map("retired_at") @db.Timestamptz(6)
  retirementReason  String?                @map("retirement_reason")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assetType         AssetType              @relation(fields: [assetTypeId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  assetStatus       AssetStatus            @relation(fields: [assetStatusId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  property          Property               @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  buildingArea      BuildingArea?          @relation(fields: [buildingAreaId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: Cascade)
  serviceLocation   ServiceLocation?       @relation(fields: [serviceLocationId, buildingAreaId, propertyId, organizationId], references: [id, buildingAreaId, propertyId, organizationId], onDelete: Restrict, onUpdate: Cascade)
  department        Department?            @relation(fields: [departmentId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: Cascade)
  custodian         User?                  @relation("AssetCustodian", fields: [custodianUserId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  assignments       AssetAssignment[]
  locationHistory   AssetLocationHistory[]
  procurement       ProcurementMetadata?
  externalLinks     ExternalSystemLink[]

  @@unique([id, organizationId])
  @@index([organizationId, assetTag])
  @@index([propertyId, assetStatusId, updatedAt])
  @@index([assetTypeId, organizationId])
  @@index([assetStatusId, organizationId])
  @@index([buildingAreaId, propertyId, organizationId])
  @@index([serviceLocationId, propertyId, organizationId])
  @@index([departmentId, propertyId, organizationId])
  @@index([custodianUserId, organizationId])
  @@map("assets")
  @@schema("service_desk")
}

model AssetAssignment {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  assetId          String       @map("asset_id") @db.Uuid
  propertyId       String       @map("property_id") @db.Uuid
  custodianUserId  String?      @map("custodian_user_id") @db.Uuid
  departmentId     String?      @map("department_id") @db.Uuid
  assignedByUserId String       @map("assigned_by_user_id") @db.Uuid
  note             String?
  assignedAt       DateTime     @map("assigned_at") @db.Timestamptz(6)
  endedAt          DateTime?    @map("ended_at") @db.Timestamptz(6)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset            Asset        @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  property         Property     @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  custodian        User?        @relation("AssetAssignmentCustodian", fields: [custodianUserId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  department       Department?  @relation(fields: [departmentId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: Cascade)
  assignedBy       User         @relation("AssetAssignmentActor", fields: [assignedByUserId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@index([assetId, organizationId, assignedAt])
  @@index([propertyId, organizationId])
  @@index([custodianUserId, organizationId])
  @@index([departmentId, propertyId, organizationId])
  @@index([assignedByUserId, organizationId])
  @@map("asset_assignments")
  @@schema("service_desk")
}

model AssetLocationHistory {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String           @map("organization_id") @db.Uuid
  assetId               String           @map("asset_id") @db.Uuid
  fromPropertyId        String?          @map("from_property_id") @db.Uuid
  fromBuildingAreaId    String?          @map("from_building_area_id") @db.Uuid
  fromServiceLocationId String?          @map("from_service_location_id") @db.Uuid
  toPropertyId          String           @map("to_property_id") @db.Uuid
  toBuildingAreaId      String?          @map("to_building_area_id") @db.Uuid
  toServiceLocationId   String?          @map("to_service_location_id") @db.Uuid
  movedByUserId         String           @map("moved_by_user_id") @db.Uuid
  reason                String
  movedAt               DateTime         @map("moved_at") @db.Timestamptz(6)
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset                 Asset            @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  fromProperty          Property?        @relation("AssetMoveFromProperty", fields: [fromPropertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  fromBuildingArea      BuildingArea?    @relation("AssetMoveFromBuilding", fields: [fromBuildingAreaId, fromPropertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: Cascade)
  fromServiceLocation   ServiceLocation? @relation("AssetMoveFromServiceLocation", fields: [fromServiceLocationId, fromBuildingAreaId, fromPropertyId, organizationId], references: [id, buildingAreaId, propertyId, organizationId], onDelete: Restrict, onUpdate: Cascade)
  toProperty            Property         @relation("AssetMoveToProperty", fields: [toPropertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  toBuildingArea        BuildingArea?    @relation("AssetMoveToBuilding", fields: [toBuildingAreaId, toPropertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: Cascade)
  toServiceLocation     ServiceLocation? @relation("AssetMoveToServiceLocation", fields: [toServiceLocationId, toBuildingAreaId, toPropertyId, organizationId], references: [id, buildingAreaId, propertyId, organizationId], onDelete: Restrict, onUpdate: Cascade)
  movedBy               User             @relation("AssetMoveActor", fields: [movedByUserId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@index([assetId, organizationId, movedAt])
  @@index([fromPropertyId, organizationId])
  @@index([fromBuildingAreaId, fromPropertyId, organizationId])
  @@index([fromServiceLocationId, fromBuildingAreaId, fromPropertyId, organizationId])
  @@index([toPropertyId, organizationId])
  @@index([toBuildingAreaId, toPropertyId, organizationId])
  @@index([toServiceLocationId, toBuildingAreaId, toPropertyId, organizationId])
  @@index([movedByUserId, organizationId])
  @@map("asset_location_history")
  @@schema("service_desk")
}

